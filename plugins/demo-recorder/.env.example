# ElevenLabs API key — required for TTS narration.
# Get one at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_your_key_here

# Voice ID — defaults to Adam (deep, professional) if unset.
# Browse: https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Model — fast and cheap; change to `eleven_multilingual_v2` for higher quality.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
